# Создаём .gitignore заново
cat > .gitignore << 'EOF'
# ========== PYTHON ПРОЕКТ ==========
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ========== ALLURE ==========
allure-results/
allure-report/

# ========== ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ ==========
.env
.venv
venv/
env/

# ========== IDE ==========
.vscode/
.idea/
*.swp
*.swo

# ========== СИСТЕМНЫЕ ФАЙЛЫ ==========
.DS_Store
Thumbs.db

# ========== ЛОГИ И ВРЕМЕННЫЕ ФАЙЛЫ ==========
*.log
*.tmp
EOF